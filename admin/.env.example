# Copy to .env and generate a fresh secret with npm run setup.
BETTER_AUTH_URL=http://localhost:4174
BETTER_AUTH_SECRET=
OWNER_EMAIL=kraussvitaliy@gmail.com
AUTH_DATABASE_PATH=.data/auth.sqlite
HOST=127.0.0.1
# Only set this behind a reverse proxy that overwrites X-Forwarded-For.
# Example for a local nginx proxy: TRUST_PROXY_IPS=127.0.0.1,::1
TRUST_PROXY_IPS=
PORT=4174
NODE_ENV=development
