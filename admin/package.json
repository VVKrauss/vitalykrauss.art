  },
  "dependencies": {
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "cropperjs": "2.3.1",
    "express": "5.3.0",
    "multer": "2.5.0",
    "sharp": "0.35.5",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
