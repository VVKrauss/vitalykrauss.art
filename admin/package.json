{
  "name": "vitaly-krauss-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
